{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wrong76_nonthinking_gold/gold_record.schema.json",
  "title": "Wrong76 non-thinking Gold Blueprint record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "source_id",
    "source",
    "steps",
    "target_theorem",
    "nodes",
    "labels",
    "deterministic_validation",
    "gold_fidelity_review",
    "completion"
  ],
  "properties": {
    "schema_version": {"const": "wrong76_gold_v1"},
    "record_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "subset": {"type": "string"},
    "split": {"type": "string"},
    "source": {
      "type": "object",
      "required": [
        "problem",
        "nonthinking_cot",
        "claimed_answer",
        "extraction_rule",
        "problem_sha256",
        "nonthinking_cot_sha256"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "ordinal", "source_span", "char_start", "char_end"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "source_span": {"type": "string", "minLength": 1},
          "char_start": {"type": "integer", "minimum": 0},
          "char_end": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "target_theorem": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/node"}
    },
    "labels": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/label"}
    },
    "deterministic_validation": {"type": "object"},
    "gold_fidelity_review": {"type": "object"},
    "completion": {"type": "object"}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "order",
        "kind",
        "node_role",
        "source_step_ids",
        "dependencies",
        "is_target",
        "in_root_closure",
        "lean_declaration",
        "declaration_sha256"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["definition", "lemma", "theorem"]},
        "node_role": {
          "enum": ["problem_grounding", "cot_claim", "formal_bridge"]
        },
        "source_step_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "uniqueItems": true
        },
        "primary_source_step_id": {"type": "string"},
        "problem_source_span": {"type": "string"},
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "is_target": {"type": "boolean"},
        "in_root_closure": {"type": "boolean"},
        "lean_declaration": {"type": "string", "minLength": 1},
        "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "required": ["kind", "node_role", "source_step_ids", "dependencies", "label"],
      "properties": {
        "kind": {"enum": ["definition", "lemma", "theorem"]},
        "node_role": {
          "enum": ["problem_grounding", "cot_claim", "formal_bridge"]
        },
        "source_step_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "label": {
          "enum": ["definition_valid", "proved", "disproved", "blocked_by_dependency"]
        },
        "blocked_by": {"type": "array", "items": {"type": "string"}},
        "proof_body": {"type": "string"},
        "negated_declaration": {"type": "string"},
        "proof_method": {"type": "string"},
        "lean_verified": {"type": "boolean"},
        "complete_lean_path": {"type": "string"},
        "lean_code_sha256": {"type": "string"},
        "proof_profile": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
